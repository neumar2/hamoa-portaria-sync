# ==============================================================================
# HAMOA PORTARIA SYNC - ARQUIVO DE EXEMPLO (.env.example)
# Copie este arquivo para ".env" e configure as credenciais do seu ambiente.
# ==============================================================================

# Porta do Servidor Web
PORT=3344

# Conexão com o Banco de Dados SQL Server (MDC 4WEB)
# Ex: SEU_SERVIDOR\SQLEXPRESS ou 192.168.0.X\SQLEXPRESS
MDC_SQL_SERVER=localhost\SQLEXPRESS
MDC_SQL_DATABASE=MDC4WEBDB
MDC_SQL_USER=sa
MDC_SQL_PASSWORD=SUA_SENHA_AQUI

# ID da Planilha do Google Sheets (opcional se usar apenas SQL Server)
# Encontrado na URL da planilha: https://docs.google.com/spreadsheets/d/[ID_DA_PLANILHA]/edit
GOOGLE_SHEET_ID=

# Intervalo da Sincronização Automática em segundo plano (em minutos)
SYNC_INTERVAL_MINUTES=60

# Servidor Web do MDC 4WEB para Verificação de Conectividade / Status
MDC_WEB_HOST=localhost
MDC_WEB_PORT=8888

# Caminho de contingência de backup de arquivos (.bak)
MDC_BACKUP_PATH=
